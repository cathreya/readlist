# LLM provider configuration
# Set your preferred provider's API key and base URL.

# Anthropic (default)
ANTHROPIC_API_KEY=your-key-here

# Or use any OpenAI-compatible provider:
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Or local Ollama:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3:70b

# Obsidian reading notes (separate from flashcards)
# Notes are written through Obsidian's built-in obsidian:// URI handler.
# mode=uri: local server opens Obsidian directly.
# mode=queue: remote server queues URIs for the Mac note agent.
FLASHCAP_OBSIDIAN_ENABLED=1
FLASHCAP_OBSIDIAN_VAULT=Writing
FLASHCAP_OBSIDIAN_FOLDER=Reading
FLASHCAP_OBSIDIAN_MODE=uri
# Note body is minimal by default; 1 adds a short surrounding-context excerpt.
FLASHCAP_NOTE_CONTEXT=0
# Days in note headings are grouped in this timezone.
FLASHCAP_TIMEZONE=Europe/Dublin

# Bind address. Keep 127.0.0.1 locally; on a remote box bind the Tailscale IP
# or use Tailscale Serve.
FLASHCAP_HOST=127.0.0.1

# Public origin injected into the userscript. Set this when running behind
# Tailscale Serve (or another TLS proxy), because the backend itself sees HTTP.
# FLASHCAP_PUBLIC_URL=https://hermes.taila17c7c.ts.net

# FSRS scheduling. Desired retention is the target recall probability; 0.90 is
# the usual default. Set FUZZING=0 if you want exact, non-randomized intervals.
FLASHCAP_DESIRED_RETENTION=0.90
FLASHCAP_FSRS_FUZZING=1

# Reading list: pull links from a Telegram channel.
# Create a bot with @BotFather and make it an admin in the channel. Admin
# rights are what let it read every post and delete a finished message.
# Long polling starts with the server, so no webhook or public port is needed.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Optional allowlist of chat ids, comma separated. Empty accepts every chat.
# TELEGRAM_CHAT_IDS=-1001234567890
# Marking an item done forwards the original message here, then deletes it
# from the source channel.
# TELEGRAM_DONE_CHAT_ID=-1001234567890
# Set to 0 to run the server without the poller.
# FLASHCAP_TELEGRAM_POLL=1
# Long-poll timeout in seconds.
# FLASHCAP_TELEGRAM_TIMEOUT=25
